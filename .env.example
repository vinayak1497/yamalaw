# ======================= YamaLaw =======================
# Copy to .env and adjust. Safe placeholders only — never commit secrets.

# ---- Application (CORE) ----
APP_NAME=YamaLaw
APP_ENV=development
DEMO_MODE=true
PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# ---- Database ----
# Default: local SQLite file (zero-config). Set DATABASE_URL for Postgres.
DB_PATH=./backend/data/yamalaw.sqlite
DATABASE_URL=

# ---- AI (all optional; app works with AI_ENABLED=false) ----
AI_ENABLED=false
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Embeddings ----
EMBEDDINGS_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers

# ---- Storage ----
STORAGE_PROVIDER=local
UPLOAD_DIR=./backend/uploads
MAX_FILE_MB=25
# Optional MinIO (OFF by default)
MINIO_ENABLED=false
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=yamalaw

# ---- Document intelligence ----
OCR_ENABLED=true

# ---- Translation ----
TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=local

# ---- Email (OFF by default; internal notifications always work) ----
EMAIL_ENABLED=false

# ---- Notifications ----
NOTIFICATIONS_ENABLED=true

# ---- Video / hearings ----
WEBRTC_ENABLED=true

# ---- Frontend ----
VITE_API_URL=http://localhost:8080

# ---- Case readiness weights (must sum sensibly; defaults below) ----
RW_DOCUMENTS=30
RW_EVIDENCE=25
RW_INFORMATION=15
RW_PREREQUISITES=15
RW_JURISDICTION=10
RW_PROCEDURAL=5
